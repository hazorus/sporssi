AddType application/manifest+json .webmanifest

# Apache: käännetyt tiedostot (assets/) saa välimuistittaa pitkään,
# index.html ja config.js eivät.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|config\.js|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Tietoturvaotsakkeet. CSP sallii vain oman palvelimen skriptit, tyylit, yhteydet ja workerit.
# 'unsafe-inline' tyyleille tarvitaan, koska kaaviot ja Svelte asettavat style-attribuutteja.
# Jos config.js:n apiBase osoittaa toiseen palvelimeen, lisää se connect-src-listaan.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Suojaus siltä varalta, että palvelinpuolen tiedostoja päätyy tähän hakemistoon:
# tietokanta, asetukset (ENTSO-E-token), Python-koodi ja lähdekoodi eivät saa näkyä verkkoon.
# Paras ratkaisu on pitää repo verkkohakemiston ulkopuolella ja kopioida tänne vain web/dist.
<IfModule mod_alias.c>
  RedirectMatch 404 "(?i)\.(sqlite3?|db|env|py|pyc|md|toml|ini|cfg|conf|service|example|lock|sh)(-wal|-shm|-journal)?$"
  RedirectMatch 404 "/(server|data|var|scripts|deploy|web|tests|node_modules|\.venv|\.git)(/|$)"
  RedirectMatch 404 "/(requirements[^/]*\.txt|package(-lock)?\.json)$"
</IfModule>
